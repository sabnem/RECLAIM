# Local development template only. Never put real credentials in this file.
SECRET_KEY=django-insecure-replace-this-for-your-installation
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.0.13
# Leave DATABASE_URL unset to use local SQLite.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SITE_URL=http://127.0.0.1:8000
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
# Production: follow docs/RENDER_DEPLOYMENT.md and configure Render Environment.
